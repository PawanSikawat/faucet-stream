sponse and needed inside every","+/// data request's raw XML body. Only exact `${name}` occurrences for a captured","+/// `name` are replaced; any other `${...}` token is left untouched. Applied per","+/// request, after the parent-context substitution.","+fn substitute_captured(s: &str, captured: &BTreeMap<String, String>) -> String {","+    if captured.is_empty() || !s.contains(\"${\") {","+        return s.to_string();","+    }","+    let mut out = s.to_string();","+    for (k, v) in captured {","+        out = out.replace(&format!(\"${{{k}}}\"), v);","+    }","+    out","+}","+"," /// the REST source's body-fingerprint guard (audit #146 H4/H5)."," fn page_fingerprint(records: &[Value]) -> u64 {","     use std::hash::{Hash, Hasher};"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"f6cfc754-392c-4a60-98aa-7318fd317c07","session_id":"55398c64-7c65-40db-9b68-886111a86d7f","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.228","gitBranch":"feat/bigquery-auto-create-table","slug":"linear-noodling-leaf"}
