e-folder","mcp__claude_ai_Notion__notion-create-pages","mcp__claude_ai_Notion__notion-create-view","mcp__claude_ai_Notion__notion-download-attachment","mcp__claude_ai_Notion__notion-duplicate-page","mcp__claude_ai_Notion__notion-fetch","mcp__claude_ai_Notion__notion-get-async-task","mcp__claude_ai_Notion__notion-get-comments","mcp__claude_ai_Notion__notion-get-teams","mcp__claude_ai_Notion__notion-get-users","mcp__claude_ai_Notion__notion-list-favorite-pages","mcp__claude_ai_Notion__notion-list-private-pages","mcp__claude_ai_Notion__notion-list-recent-pages","mcp__claude_ai_Notion__notion-list-shared-pages","mcp__claude_ai_Notion__notion-move-pages","mcp__claude_ai_Notion__notion-query-data-sources","mcp__claude_ai_Notion__notion-query-meeting-notes","mcp__claude_ai_Notion__notion-search","mcp__claude_ai_Notion__notion-search-agents","mcp__claude_ai_Notion__notion-update-data-source","mcp__claude_ai_Notion__notion-update-folder","mcp__claude_ai_Notion__notion-update-page","mcp__claude_ai_Notion__notion-update-view","mcp__claude_ai_PostHog__authenticate","mcp__claude_ai_PostHog__complete_authentication","mcp__claude_ai_Sentry__authenticate","mcp__claude_ai_Sentry__complete_authentication","mcp__claude_ai_Slack__slack_add_reaction","mcp__claude_ai_Slack__slack_create_canvas","mcp__claude_ai_Slack__slack_get_reactions","mcp__claude_ai_Slack__slack_list_channel_members","mcp__claude_ai_Slack__slack_read_canvas","mcp__claude_ai_Slack__slack_read_channel","mcp__claude_ai_Slack__slack_read_file","mcp__claude_ai_Slack__slack_read_thread","mcp__claude_ai_Slack__slack_read_user_profile","mcp__claude_ai_Slack__slack_schedule_message","mcp__claude_ai_Slack__slack_search_channels","mcp__claude_ai_Slack__slack_search_emojis","mcp__claude_ai_Slack__slack_search_public","mcp__claude_ai_Slack__slack_search_public_and_private","mcp__claude_ai_Slack__slack_search_users","mcp__claude_ai_Slack__slack_send_message","mcp__claude_ai_Slack__slack_send_message_draft","mcp__claude_ai_Slack__slack_update_canvas","mcp__claude_ai_Sprinto_MCP__authenticate","mcp__claude_ai_Sprinto_MCP__complete_authentication","mcp__claude_ai_Tavily__authenticate","mcp__claude_ai_Tavily__complete_authentication","mcp__claude_ai_Webflow__authenticate","mcp__claude_ai_Webflow__complete_authentication","mcp__claude_ai_dbt__authenticate","mcp__claude_ai_dbt__complete_authentication","mcp__claude_ai_monday_com__authenticate","mcp__claude_ai_monday_com__complete_authentication","mcp__claude_ai_n8n__authenticate","mcp__claude_ai_n8n__complete_authentication","mcp__headroom__headroom_compress","mcp__headroom__headroom_retrieve","mcp__headroom__headroom_stats","mcp__plugin_agent-spartan_temporal__count_activities","mcp__plugin_agent-spartan_temporal__describe_activity","mcp__plugin_agent-spartan_temporal__describe_schedule","mcp__plugin_agent-spartan_temporal__describe_workflow","mcp__plugin_agent-spartan_temporal__get_activity_result","mcp__plugin_agent-spartan_temporal__get_workflow_history","mcp__plugin_agent-spartan_temporal__get_workflow_result","mcp__plugin_agent-spartan_temporal__list_activities","mcp__plugin_agent-spartan_temporal__list_schedules","mcp__plugin_agent-spartan_temporal__list_workflows","mcp__plugin_agent-spartan_temporal__query_workflow"],"readdedNames":[],"pendingMcpServers":["headroom","plugin:agent-spartan:temporal","tokensave"]},"type":"attachment","uuid":"90ee08a1-8ce3-440f-9ca7-64f0c448ad33","timestamp":"2026-08-24T08:49:21.679Z","userType":"external","entrypoint":"cli","cwd":"/Users/c-sikawats/Documents/GitHub/Personal/faucet-stream","sessionId":"55398c64-7c65-40db-9b68-886111a86d7f","version":"2.1.231","gitBranch":"feat/bigquery-auto-create-table","slug":"linear-noodling-leaf"}
